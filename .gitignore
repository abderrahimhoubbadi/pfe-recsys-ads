# ═══════════════════════════════════════════════════════════════
#  PFE RecSys Ads — .gitignore (Final Version)
# ═══════════════════════════════════════════════════════════════

# ── Python ──────────────────────────────────────────────────────
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# ── Virtual environments ────────────────────────────────────────
.venv/

# ── Reports, Presentations & Documentation (kept locally) ──────
rapport_pfe/
presentation_soutenance/
documentation/

# ── Root-level office files ─────────────────────────────────────
*.docx
*.pptx
*.docx:Zone.Identifier
Guide_Rapport_PFE.pdf

# ── Archived legacy code ────────────────────────────────────────
archive/

# ── Data (generated at runtime / downloaded separately) ─────────
data/

# ── Large generated metrics files ───────────────────────────────
metrics/trajectories_best_policy.json

# ── LaTeX build artifacts ───────────────────────────────────────
*.aux
*.log
*.toc
*.out
*.lof
*.lot
*.synctex.gz
*.fdb_latexmk
*.fls
*.bbl
*.blg
*.bcf
*.run.xml

# ── IDE ─────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp

# ── OS ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Secrets ─────────────────────────────────────────────────────
.env

# ── Lock file (large, auto-generated by uv) ─────────────────────
uv.lock

# ── Caches ──────────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/

# ── Old models ──────────────────────────────────────────────────
models/
